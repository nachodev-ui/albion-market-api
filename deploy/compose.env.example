# Copia este archivo como deploy/compose.env.local y ajusta solo valores no secretos.
COMPOSE_PROJECT_NAME=albion-market-api
API_IMAGE=albion-market-api:local
API_HOST_PORT=18080
API_ALLOWED_ORIGINS=https://example.invalid
INGEST_TOKEN_ID=receiver-current
INGEST_REQUIRE_HTTPS=true
TRUST_PROXY_HEADERS=false

# Perfil opcional de observabilidad.
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION_TIME=7d
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000

POSTGRES_DB=albion_market
POSTGRES_USER=albion_market

# Las rutas se resuelven desde deploy/compose.yaml.
POSTGRES_PASSWORD_SECRET_FILE=../secrets/deployment/postgres-password
DATABASE_URL_SECRET_FILE=../secrets/deployment/database-url
INGEST_TOKEN_SECRET_FILE=../secrets/deployment/ingest-current.token

# Metadatos OCI del build local.
IMAGE_VERSION=local
IMAGE_REVISION=unknown
IMAGE_CREATED=1970-01-01T00:00:00Z
