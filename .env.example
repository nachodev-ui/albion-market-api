APP_ENV=development
HTTP_ADDR=:8080
# Configura el valor O el archivo, nunca ambos. DATABASE_URL_FILE es la
# opción recomendada para secretos montados en contenedores.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/albion_market?sslmode=disable
DATABASE_URL_FILE=

# En desarrollo se cargan .env.local/.env.<entorno>.local sin sobrescribir
# variables ya definidas por el sistema. En production LOAD_DOTENV=false por defecto.
# LOAD_DOTENV=true

# Autenticación OAuth/OIDC para usuarios finales. En production usa estos
# identificadores públicos por defecto y exige read:account en las rutas de cuenta.
AUTH_ENABLED=false
AUTH_EMERGENCY_DISABLED=false
AUTH_ISSUER=https://albion-production-calculator.us.auth0.com/
AUTH_AUDIENCE=https://albion-market-api
AUTH_JWKS_CACHE_TTL=15m
AUTH_HTTP_TIMEOUT=5s
AUTH_CLOCK_SKEW=30s

# Credencial actual: define el valor O el archivo, nunca ambos.
# Los archivos son la opción recomendada para Docker, systemd y gestores de secretos.
INGEST_BEARER_TOKEN=
INGEST_BEARER_TOKEN_FILE=./secrets/ingest-current.token
INGEST_BEARER_TOKEN_ID=current

# Credencial anterior opcional para una rotación sin interrupciones.
INGEST_BEARER_TOKEN_PREVIOUS=
INGEST_BEARER_TOKEN_PREVIOUS_FILE=
INGEST_BEARER_TOKEN_PREVIOUS_ID=previous

# Mínimo 32 en producción. HTTPS se exige por defecto en production y se
# desactiva por defecto en development/test.
INGEST_MIN_TOKEN_LENGTH=32
# INGEST_REQUIRE_HTTPS=false

# Límites de solicitudes. El límite de ingesta se aplica al cuerpo comprimido
# y también al contenido descomprimido para evitar cargas gzip expansivas.
MAX_INGEST_BODY_BYTES=5242880
MAX_PUBLIC_BODY_BYTES=1048576
MAX_HEADER_BYTES=1048576

# Timeouts del servidor HTTP.
READ_HEADER_TIMEOUT=2s
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# Orígenes permitidos separados por coma. En production no se permite "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Limitador token-bucket por dirección IP. /healthz, /readyz, /metrics y OPTIONS quedan exentos.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
RATE_LIMIT_CLIENT_TTL=10m

# Actívalo únicamente detrás de un proxy confiable que reescriba
# X-Forwarded-For, X-Real-IP y X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false

# Formato de logs. En production el valor predeterminado es json; en los
# demás entornos es text. JSON desactiva automáticamente los colores ANSI.
LOG_FORMAT=text
# auto: colores solo en una terminal interactiva para LOG_FORMAT=text.
# always: fuerza ANSI. never: desactiva colores.
LOG_COLOR=auto
