APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/albion_market?sslmode=disable

# Token actual y token anterior opcional para rotacion sin interrupciones.
INGEST_BEARER_TOKEN=CHANGE_ME
INGEST_BEARER_TOKEN_PREVIOUS=

# Limites de solicitudes. El limite de ingesta se aplica al cuerpo comprimido
# y tambien al contenido descomprimido para evitar cargas gzip expansivas.
MAX_INGEST_BODY_BYTES=5242880
MAX_PUBLIC_BODY_BYTES=1048576
MAX_HEADER_BYTES=1048576

# Timeouts del servidor HTTP.
READ_HEADER_TIMEOUT=2s
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# Origenes permitidos separados por coma. En production no se permite "*".
# Una lista vacia deshabilita las solicitudes CORS, pero no afecta llamadas
# servidor-a-servidor ni solicitudes sin cabecera Origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Limitador token-bucket por direccion IP. /healthz y OPTIONS quedan exentos.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
RATE_LIMIT_CLIENT_TTL=10m

# Solo debe activarse cuando la API esta detras de un proxy confiable que
# reescribe X-Forwarded-For/X-Real-IP. Mantener false al exponerla directamente.
TRUST_PROXY_HEADERS=false

# auto: usa colores solo en una terminal interactiva.
# always: fuerza colores ANSI. never: los desactiva.
LOG_COLOR=auto
